{
  "name": "lobyas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix .",
    "knip": "knip",
    "type-check": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run type-check && pnpm run knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "mobile:sync": "cap sync",
    "mobile:release": "scripts/mobile-release.sh",
    "mobile:splash": "vitest run --config scripts/splash.vitest.config.ts",
    "mobile:assets": "capacitor-assets generate --ios --android --assetPath resources --iconBackgroundColor '#fdfcf9' --splashBackgroundColor '#fdfcf9' --splashBackgroundColorDark '#1c1916'",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios"
  },
