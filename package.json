    "@elevenlabs/elevenlabs-js": "^2.66.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@posthog/ai": "^8.13.4",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.112.4",
