# Copy to .env.local and fill from `pnpm supabase:status` (local)
# or from your Supabase project settings (remote).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — from `pnpm supabase:status` (service_role key) or Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Secret for the narration sync route: the app's own kick and the Supabase cron
# job that calls it. See docs/supabase/narration-sync-cron.md.
AI_INTERNAL_SECRET=
# Public app URL for auth redirects (OAuth, password reset) and the narration cron.
# Must be reachable from Supabase (local: use a tunnel URL).
APP_BASE_URL=

# Server-only — Resend API key for sending invite emails (resend.com dashboard).
RESEND_API_KEY=

# Server-only — Google Cloud Text-to-Speech API key for narration (WaveNet voices).
# Restrict the key to the Cloud Text-to-Speech API in the Google Cloud console.
GOOGLE_TTS_API_KEY=

# Server-only — API key for Gemini narration (aiplatform.googleapis.com, Gemini TTS).
GEMINI_TTS_API_KEY=

# Server-only — Murf API key for narration (murf.ai API dashboard).
MURF_API_KEY=

# Server-only — ElevenLabs API key for narration (elevenlabs.io dashboard).
# Admin > AI > Narration picks which provider is tried first for words and phrases, other terms and stories.
ELEVENLABS_API_KEY=

# Server-only — Supabase Storage's S3-compatible protocol, used to upload/sign
# narration audio (Supabase dashboard: Project Settings > Storage > S3 Connection).
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=term-narrations

# Server-only — the app's own AI key, used for AI quizzes and Stories (accounts
# spend AI credits). Leave the key empty to switch AI credits off. Provider is "google" (default) or "anthropic".
CENTRAL_LLM_PROVIDER=google
CENTRAL_LLM_API_KEY=

# Sign in with Apple on the web: the Services ID from Apple Developer. Leave empty to hide the
# button in browsers (the iOS app does not need it).
NEXT_PUBLIC_APPLE_SERVICES_ID=

# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
# Point this at your reverse-proxy subdomain once it is set up.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Analytics only run in production builds. Set to true to send events from local dev.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Server-side events and traces go straight to PostHog, not through the proxy.
POSTHOG_SERVER_HOST=https://eu.i.posthog.com
