{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "max-lines": ["error", 280],
    "complexity": [
      "error",
      {
        "max": 15
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@capacitor/*", "@capgo/*", "capacitor-native-settings"],
            "message": "Native calls go through lib/native (see docs/native-bridge.md)."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "node_modules/**",
    "lib/supabase/database.types.ts",
    "ios/**",
    "android/**"
  ],
  "overrides": [
    {
      "files": [
        "components/ui/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "widget/lobyas.widget/index.jsx"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["components/illustrations/scenes/**"],
      "rules": {
        "max-lines": ["error", 500]
      }
    },
    {
      "files": [
        "lib/native/**",
        "capacitor.config.ts",
        "components/auth/google-signin-button.tsx",
        "components/native/native-auth-bridge.tsx",
        "components/native/native-splash.tsx",
        "components/native/native-system-bars.tsx",
        "lib/auth/apple-client.ts",
        "lib/feedback/haptics.ts",
        "lib/reminders/native.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
