# Copy to .env.mobile (git-ignored), fill it in, then run scripts/set-mobile-secrets.sh.
# Leave a line empty to skip it. Put the value right after the "=", with nothing after it on
# the same line (no comments). Quotes around a value are optional. Paths may start with ~/.

# Apple Developer -> Membership details -> Team ID (10 characters, not sensitive)
APPLE_TEAM_ID=

# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Path to the downloaded AuthKey_XXXXXXXXXX.p8 file
APP_STORE_CONNECT_KEY_FILE=

# The private repo that stores the encrypted iOS certificate, as owner/repo or the full https URL
MATCH_GIT_URL=
# GitHub user that owns the token, and the fine-grained token (Contents: read and write on that repo only)
MATCH_GIT_USER=
MATCH_GIT_TOKEN=
# A password you invent; keep it in your password manager. Losing it makes the stored certificate unreadable.
MATCH_PASSWORD=

# Android (Play) -- only if you set up Android releases here
# Path to the upload keystore file
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Path to the Play Console service account JSON file
PLAY_SERVICE_ACCOUNT_FILE=
